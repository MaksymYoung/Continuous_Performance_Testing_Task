// Jenkinsfile - Gatling (PerfTestSimulation, Maven) on Linux/Ubuntu
// sh/bash only, no PowerShell. Same idea as the JMeter Jenkinsfile:
//   ramp-up -> steady state, one overall HTML report (no separate steady-state report).
// The project is copied into the Jenkins container by deploy_gatling_ubuntu.sh.
// All load parameters are build parameters ("Build with Parameters").
// Defaults are declared ONCE, in DEFAULTS below; the parameters block reads them from there and the
// 'Init' stage exports the resolved values as environment variables, so the shell code needs no fallbacks.

def DEFAULTS = [
    START_USERS: '3', USERS: '5', TOTAL_DURATION_SEC: '600', RAMP_UP_SEC: '120',
    TT_MIN: '2000', TT_MAX: '5000', CONNECT_TIMEOUT: '5000', RESPONSE_TIMEOUT: '10000',
    MIN_SUCCESS_PCT: '99',
    APP: '172.17.0.1', APP_PORT: '80'
]
def common = null   // shared helpers, loaded in the 'Init' stage

pipeline {
    agent any

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'START_USERS',        defaultValue: DEFAULTS.START_USERS,        description: 'Number of virtual users at the start of the ramp-up')
        string(name: 'USERS',              defaultValue: DEFAULTS.USERS,              description: 'Number of virtual users at the end of the ramp-up (steady state)')
        string(name: 'TOTAL_DURATION_SEC', defaultValue: DEFAULTS.TOTAL_DURATION_SEC, description: 'Total test duration, seconds (ramp-up + steady state)')
        string(name: 'RAMP_UP_SEC',        defaultValue: DEFAULTS.RAMP_UP_SEC,        description: 'Ramp-up time, seconds')
        string(name: 'TT_MIN',             defaultValue: DEFAULTS.TT_MIN,             description: 'Think time min, ms')
        string(name: 'TT_MAX',             defaultValue: DEFAULTS.TT_MAX,             description: 'Think time max, ms')
        string(name: 'CONNECT_TIMEOUT',    defaultValue: DEFAULTS.CONNECT_TIMEOUT,    description: 'HTTP connect timeout, ms')
        string(name: 'RESPONSE_TIMEOUT',   defaultValue: DEFAULTS.RESPONSE_TIMEOUT,   description: 'HTTP response timeout, ms')
        string(name: 'MIN_SUCCESS_PCT',    defaultValue: DEFAULTS.MIN_SUCCESS_PCT,    description: 'Assertion: minimum percentage of successful requests (0-100)')
        string(name: 'APP',                defaultValue: DEFAULTS.APP,                description: 'Target application host (Docker host gateway; "localhost" inside the container is the container itself)')
        string(name: 'APP_PORT',           defaultValue: DEFAULTS.APP_PORT,           description: 'Target application port')
    }

    environment {
        // ---- Constants (paths inside the Jenkins container) ----
        PROJECT_DIR  = '/var/jenkins_home/gatling_project'   // pom.xml and src/ are copied here
        JAVA_HOME    = '/var/jenkins_home/jdk21'             // JDK 21 (installed automatically if missing)
        MAVEN_HOME   = '/var/jenkins_home/maven'             // Apache Maven (installed automatically if missing)
        MAVEN_VERSION = '3.9.9'
        COMMON_LIB   = '/var/jenkins_home/perf_common/perf-common.groovy'  // shared helpers (copied by the deploy script)

        // The app (WordPress) redirects to its siteurl unless the Host header is "localhost" (same as in the JMeter test)
        SITE_URL     = 'http://localhost'
        HOST_HEADER  = 'localhost'

        // ---- Results directory of the current build (relative to workspace) ----
        RUN_DIR      = "results/build-${BUILD_NUMBER}"

        MAVEN_OPTS        = '-Xms512m -Xmx2g'
        JAVA_TOOL_OPTIONS = '-Duser.language=en -Duser.country=US -Djava.net.preferIPv4Stack=true'
    }

    stages {

        stage('Init') {
            steps {
                script {
                    if (!fileExists(env.COMMON_LIB)) {
                        error("Missing ${env.COMMON_LIB} - run deploy_gatling_ubuntu.sh")
                    }
                    common = load(env.COMMON_LIB)
                    common.exportParams(params, DEFAULTS)   // resolves defaults, checks numeric params, sets env vars
                }
            }
        }

        stage('Prepare') {
            steps {
                sh '''#!/bin/bash
set -euo pipefail

echo "== Environment check =="
whoami; uname -a

# No upper/lower limit on users - that is the caller's choice
[ "$START_USERS" -ge 1 ] || { echo "START_USERS must be >= 1"; exit 1; }
[ "$USERS" -ge 1 ]       || { echo "USERS must be >= 1"; exit 1; }
[ "$TT_MAX" -ge "$TT_MIN" ] || { echo "TT_MAX must be >= TT_MIN"; exit 1; }
[ "$MIN_SUCCESS_PCT" -le 100 ] || { echo "MIN_SUCCESS_PCT must be 0..100"; exit 1; }
[ "$TOTAL_DURATION_SEC" -gt "$RAMP_UP_SEC" ] || { echo "TOTAL_DURATION_SEC must be greater than RAMP_UP_SEC"; exit 1; }

[ -f "$PROJECT_DIR/pom.xml" ] || { echo "Missing $PROJECT_DIR/pom.xml - run deploy_gatling_ubuntu.sh first"; exit 1; }

# ---- JDK 21 (pom.xml: maven.compiler.release=21) ----
if [ ! -x "$JAVA_HOME/bin/java" ]; then
  echo "JDK 21 not found, downloading Temurin 21 into $JAVA_HOME"
  case "$(uname -m)" in x86_64) A=x64;; aarch64) A=aarch64;; *) echo "Unsupported CPU: $(uname -m)"; exit 1;; esac
  mkdir -p "$JAVA_HOME"
  curl -fsSL "https://api.adoptium.net/v3/binary/latest/21/ga/linux/$A/jdk/hotspot/normal/eclipse" \\
    | tar -xz -C "$JAVA_HOME" --strip-components=1
fi
export PATH="$JAVA_HOME/bin:$PATH"
"$JAVA_HOME/bin/java" -version 2>&1 | grep -v "Picked up" | head -1

# ---- Maven ----
if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  echo "Maven not found, downloading Apache Maven $MAVEN_VERSION into $MAVEN_HOME"
  mkdir -p "$MAVEN_HOME"
  curl -fsSL "https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz" \\
    | tar -xz -C "$MAVEN_HOME" --strip-components=1
fi
"$MAVEN_HOME/bin/mvn" -version | head -1

# ---- Fresh copy of the project into the workspace (without old results) ----
rm -rf "$WORKSPACE/project" "$WORKSPACE/$RUN_DIR"
mkdir -p "$WORKSPACE/project" "$WORKSPACE/$RUN_DIR"
cp -a "$PROJECT_DIR/." "$WORKSPACE/project/"
rm -rf "$WORKSPACE/project/target"
ls -la "$WORKSPACE/project"
'''
            }
        }

        stage('Check target') {
            steps {
                script {
                    common.checkTarget(url: "http://${env.APP}:${env.APP_PORT}/", host: env.HOST_HEADER,
                                       expect: 'Performance testing Essentials')
                }
            }
        }

        stage('Run Gatling test') {
            steps {
                sh '''#!/bin/bash
set -uo pipefail
export PATH="$JAVA_HOME/bin:$MAVEN_HOME/bin:$PATH"

HOLD=$(( TOTAL_DURATION_SEC - RAMP_UP_SEC ))
TT_CENTER=$(( (TT_MIN + TT_MAX) / 2 ))
TT_DEV=$(( (TT_MAX - TT_MIN) / 2 ))
STAMP=$(date +%Y%m%d-%H%M)

echo "Target: $APP | $START_USERS -> $USERS VU | ramp ${RAMP_UP_SEC}s | steady state ${HOLD}s"
echo "Expected duration: about $(( TOTAL_DURATION_SEC / 60 )) min (plus first-run dependency download)"

cd "$WORKSPACE/project"

mvn -B -ntp gatling:test \\
  "-DBASE_URL=$SITE_URL" \\
  "-DTARGET_URL=http://$APP:$APP_PORT" \\
  "-DHOST_HEADER=$HOST_HEADER" \\
  "-DtestTitle=test-$STAMP" \\
  "-Dgatling.runDescription=test-$STAMP" \\
  "-DCLOSED_START_USERS=$START_USERS" \\
  "-DCLOSED_USERS=$USERS" \\
  "-DRAMP_UP_PERIOD=$RAMP_UP_SEC" \\
  "-DTEST_HOLD_SEC=$HOLD" \\
  "-DSTEP_TIMEOUT_MS=$RESPONSE_TIMEOUT" \\
  "-Dthink_time_center=$TT_CENTER" \\
  "-Dthink_time_deviation=$TT_DEV" \\
  "-Dgatling.socket.connectTimeout=$CONNECT_TIMEOUT" \\
  "-Dgatling.http.requestTimeout=$RESPONSE_TIMEOUT" \\
  "-DASSERTION_TYPE=responseTime" \\
  "-DSUCCESSFUL_REQUESTS_PERCENT=$MIN_SUCCESS_PCT" 2>&1 | tee "$WORKSPACE/$RUN_DIR/console.log"

RC=${PIPESTATUS[0]}
if [ "$RC" -ne 0 ]; then echo "Gatling finished with exit code $RC (simulation error or failed assertions). See console.log"; exit "$RC"; fi
'''
            }
            post {
                always {
                    // Copy the latest Gatling HTML report to results/build-N/report_full (also when assertions failed)
                    sh '''#!/bin/bash
cd "$WORKSPACE/project" 2>/dev/null || exit 0
LATEST=$(ls -dt target/gatling/*/ 2>/dev/null | head -n 1)
if [ -n "$LATEST" ]; then
  echo "Latest Gatling report: $LATEST"
  cp -a "$LATEST" "$WORKSPACE/$RUN_DIR/report_full"
else
  echo "No Gatling report was generated."
fi
[ -f src/test/execution.log ] && cp src/test/execution.log "$WORKSPACE/$RUN_DIR/execution.log"
exit 0
'''
                }
            }
        }
    }

    post {
        always {
            script {
                if (common) {
                    common.packAndArchive(env.RUN_DIR, [[archive: 'report_full.tar.gz', glob: 'report_full']])
                    common.publishHtmlReport(dir: "${env.RUN_DIR}/report_full", index: 'index.html', name: 'Gatling Report')
                }
            }
        }
        success { echo 'Test completed. Report: build menu -> Gatling Report / Build Artifacts.' }
        failure { echo 'Failed. See Console Output and console.log in results/build-N/ artifacts.' }
    }
}
