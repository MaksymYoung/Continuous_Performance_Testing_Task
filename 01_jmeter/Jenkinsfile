// Jenkinsfile - JMeter (PerformanceEssentials.jmx) on Linux/Ubuntu
// sh/bash only, no PowerShell.
// Load model: ramp-up -> steady state -> shutdown, one overall HTML report.
// All load parameters are build parameters ("Build with Parameters").
// Defaults are declared ONCE, in DEFAULTS below; the parameters block reads them from there and the
// 'Init' stage exports the resolved values as environment variables, so the shell code needs no fallbacks.

def DEFAULTS = [
    USERS: '4', TOTAL_DURATION_SEC: '600', RAMP_UP_SEC: '30', SHUTDOWN_SEC: '10',
    TT_MIN: '2000', TT_MAX: '5000', CONNECT_TIMEOUT: '5000', RESPONSE_TIMEOUT: '10000',
    APP: '172.17.0.1', APP_PORT: '80'
]
def common = null   // shared helpers, loaded in the 'Init' stage

pipeline {
    agent any

    options {
        timeout(time: 40, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    parameters {
        string(name: 'USERS',              defaultValue: DEFAULTS.USERS,              description: 'Number of virtual users')
        string(name: 'TOTAL_DURATION_SEC', defaultValue: DEFAULTS.TOTAL_DURATION_SEC, description: 'Total test duration, seconds (ramp-up + hold + shutdown)')
        string(name: 'RAMP_UP_SEC',        defaultValue: DEFAULTS.RAMP_UP_SEC,        description: 'Ramp-up time, seconds')
        string(name: 'SHUTDOWN_SEC',       defaultValue: DEFAULTS.SHUTDOWN_SEC,       description: 'Shutdown time, seconds')
        string(name: 'TT_MIN',             defaultValue: DEFAULTS.TT_MIN,             description: 'Think time min, ms')
        string(name: 'TT_MAX',             defaultValue: DEFAULTS.TT_MAX,             description: 'Think time max, ms')
        string(name: 'CONNECT_TIMEOUT',    defaultValue: DEFAULTS.CONNECT_TIMEOUT,    description: 'HTTP connect timeout, ms')
        string(name: 'RESPONSE_TIMEOUT',   defaultValue: DEFAULTS.RESPONSE_TIMEOUT,   description: 'HTTP response timeout, ms')
        string(name: 'APP',                defaultValue: DEFAULTS.APP,                description: 'Target application host (must be reachable from the Jenkins container)')
        string(name: 'APP_PORT',           defaultValue: DEFAULTS.APP_PORT,           description: 'Target application port (must match "port" in the JMX)')
    }

    environment {
        // ---- Constants (paths inside the Jenkins container) ----
        PROJECT_DIR  = '/var/jenkins_home/perf_project'      // jmx and csv/ are copied here
        JMETER_HOME  = '/opt/apache-jmeter'                  // JMeter 5.6.3 + jpgc-casutg plugin
        JOLOKIA_JAR  = '/opt/monitoring/jolokia-agent.jar'   // optional: the agent is skipped if the file does not exist
        COMMON_LIB   = '/var/jenkins_home/perf_common/perf-common.groovy'  // shared helpers (copied by the deploy script)

        // ---- Results directory of the current build (relative to workspace) ----
        RUN_DIR      = "results/build-${BUILD_NUMBER}"
    }

    stages {

        stage('Init') {
            steps {
                script {
                    if (!fileExists(env.COMMON_LIB)) {
                        error("Missing ${env.COMMON_LIB} - run deploy_jmeter_ubuntu.sh")
                    }
                    common = load(env.COMMON_LIB)
                    common.exportParams(params, DEFAULTS)   // resolves defaults, checks numeric params, sets env vars
                }
            }
        }

        stage('Prepare') {
            steps {
                sh '''#!/bin/bash
set -euo pipefail

echo "== Environment check =="
whoami; uname -a; java -version 2>&1 | head -1

[ "$USERS" -ge 1 ] || { echo "USERS must be >= 1"; exit 1; }
[ "$TT_MAX" -ge "$TT_MIN" ] || { echo "TT_MAX must be >= TT_MIN"; exit 1; }
[ $(( TOTAL_DURATION_SEC - RAMP_UP_SEC - SHUTDOWN_SEC )) -gt 0 ] \\
  || { echo "TOTAL_DURATION_SEC must be greater than RAMP_UP_SEC + SHUTDOWN_SEC"; exit 1; }

[ -x "$JMETER_HOME/bin/jmeter" ]                || { echo "JMeter not found: $JMETER_HOME/bin/jmeter"; exit 1; }
[ -f "$PROJECT_DIR/PerformanceEssentials.jmx" ] || { echo "Missing $PROJECT_DIR/PerformanceEssentials.jmx"; exit 1; }

# The JMX looks for csv/checkout.csv relative to its own folder -> copy to workspace together with csv/
# Start from a clean state: JMeter refuses to write to a non-empty results.jtl / existing report folder
rm -rf "$WORKSPACE/project" "$WORKSPACE/$RUN_DIR"
mkdir -p "$WORKSPACE/project" "$WORKSPACE/$RUN_DIR"
cp "$PROJECT_DIR/PerformanceEssentials.jmx" "$WORKSPACE/project/"
[ -d "$PROJECT_DIR/csv" ] && cp -r "$PROJECT_DIR/csv" "$WORKSPACE/project/csv"
ls -la "$WORKSPACE/project"
'''
            }
        }

        stage('Check target') {
            steps {
                // The app (WordPress) redirects to http://localhost/ unless the Host header is "localhost" - same header as in the JMX
                script { common.checkTarget(url: "http://${env.APP}:${env.APP_PORT}/", host: 'localhost') }
            }
        }

        stage('Run JMeter test') {
            steps {
                sh '''#!/bin/bash
set -uo pipefail

HOLD=$(( TOTAL_DURATION_SEC - RAMP_UP_SEC - SHUTDOWN_SEC ))
TT_CENTER=$(( (TT_MIN + TT_MAX) / 2 ))
TT_DEV=$(( (TT_MAX - TT_MIN) / 2 ))
STAMP=$(date +%Y%m%d-%H%M)

JVM_ARGS="-Xms1g -Xmx2g -Djava.net.preferIPv4Stack=true"
if [ -f "$JOLOKIA_JAR" ]; then
  JVM_ARGS="$JVM_ARGS -javaagent:$JOLOKIA_JAR=host=127.0.0.1,port=8778"
fi
export JVM_ARGS

echo "Target: $APP:$APP_PORT | $USERS VU | ramp ${RAMP_UP_SEC}s | hold ${HOLD}s | shutdown ${SHUTDOWN_SEC}s"
echo "Expected duration: $(( TOTAL_DURATION_SEC / 60 )) min"

cd "$WORKSPACE/$RUN_DIR"
rm -rf results.jtl report_full jmeter.log console.log

"$JMETER_HOME/bin/jmeter" -n \\
  -t "$WORKSPACE/project/PerformanceEssentials.jmx" \\
  -Japp="$APP" \\
  -Jport="$APP_PORT" \\
  -Jramp_threads="$USERS" \\
  -Jramp_sec="$RAMP_UP_SEC" \\
  -Jtest_hold_sec="$HOLD" \\
  -Jshutdown_sec="$SHUTDOWN_SEC" \\
  -Jtt_min="$TT_MIN" \\
  -Jtt_max="$TT_MAX" \\
  -Jthink_time_center="$TT_CENTER" \\
  -Jthink_time_deviation="$TT_DEV" \\
  -Jconnect_timeout="$CONNECT_TIMEOUT" \\
  -Jresponse_timeout="$RESPONSE_TIMEOUT" \\
  -Jstep_timeout_ms="$RESPONSE_TIMEOUT" \\
  -Jtest_title="test-$STAMP" \\
  -l results.jtl \\
  -j jmeter.log \\
  -e -o report_full 2>&1 | tee console.log

RC=${PIPESTATUS[0]}
if [ "$RC" -ne 0 ]; then echo "JMeter finished with exit code $RC. See console.log"; exit "$RC"; fi
[ -s results.jtl ] || { echo "results.jtl is empty or missing"; exit 1; }
'''
            }
        }
    }

    post {
        always {
            script {
                if (common) {
                    common.packAndArchive(env.RUN_DIR, [[archive: 'report_full.tar.gz', glob: 'report_full']])
                    common.publishHtmlReport(dir: "${env.RUN_DIR}/report_full", index: 'index.html', name: 'JMeter Report')
                }
            }
        }
        success { echo 'Test completed. Report: build menu -> JMeter Report / Build Artifacts.' }
        failure { echo 'Failed. See Console Output and console.log / jmeter.log in results/build-N/ artifacts.' }
    }
}
